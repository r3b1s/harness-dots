# Repo-wide safety net. Harness-specific runtime state is ignored by each
# harness's own .gitignore (pi/.gitignore, omp/.gitignore).

# Credentials any harness might drop into a config dir
auth.json
*.token
.env
.env.*
secrets.yml
secret-placeholder.key

# SQLite stores (omp and newer pi: agent.db, history.db, models.db, ...)
*.db
*.db-shm
*.db-wal

# Harness-specific Project Artifacts
.claude

# Python bytecode (skills/*/scripts)
__pycache__/
