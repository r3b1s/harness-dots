# coi/ holds only authored coi configuration and profiles. Runtime state
# (sessions, storage, logs, locks, image-meta.json) stays in $COI_HOME (~/.coi);
# install.sh copies tracked files there, never links them.

*.bak
.coi-*

# Runtime state if --home is ever pointed here
image-meta.json
locks/
logs/
sessions/
sessions-*/
storage/
