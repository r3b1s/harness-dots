#!/usr/bin/env bash
# shellcheck shell=bash
# Pi CTF agent
#
# Two ways to use this file:
#   run it     symlink it onto PATH (../../install.sh) and call `pi-ctf ...`
#   source it  defines the `pi-ctf` function in the current shell
# Pi's own subcommands work as usual: `pi-ctf install npm:pkg`, `pi-ctf list`.

_PI_BASH_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
# shellcheck source=_launch.bash
source "$_PI_BASH_DIR/_launch.bash"

pi-ctf() {
  # --- PROFILE ---------------------------------------------------------------
  local profile=agent_ctf
  local prompt=append_ctf_0.md   # a file in the repo's system-prompts/; "" for none
  local -a env_extra=()   # extra environment for this profile, e.g. (NAME=value)
  # ---------------------------------------------------------------------------
  _pi_launch "$profile" "$prompt" "${env_extra[@]}" -- "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  pi-ctf "$@"
fi
