#!/usr/bin/env bash
# shellcheck shell=bash
# Pi vanilla: the harness-dots `agent` profile, no appended system prompt.
#
# Two ways to use this file:
#   run it     symlink it onto PATH (../../install.sh) and call `vpi ...`
#   source it  defines the `vpi` function in the current shell
# Pi's own subcommands work as usual: `vpi install npm:pkg`, `vpi list`.

_PI_BASH_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
# shellcheck source=_launch.bash
source "$_PI_BASH_DIR/_launch.bash"

vpi() {
  # --- PROFILE ---------------------------------------------------------------
  local profile=agent
  local prompt=""   # a file in the repo's system-prompts/; "" for none
  local -a env_extra=()   # extra environment for this profile, e.g. (NAME=value)
  # ---------------------------------------------------------------------------
  _pi_launch "$profile" "$prompt" "${env_extra[@]}" -- "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  vpi "$@"
fi
