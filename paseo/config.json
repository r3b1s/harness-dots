{
  "version": 1,
  "daemon": {
    "mcp": {
      "injectIntoAgents": true
    },
    "relay": {
      "enabled": false
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "agents": {
    "providers": {
      "codex": {
        "enabled": false
      },
      "muse": {
        "enabled": false
      },
      "pi-ctf": {
        "extends": "pi",
        "label": "Pi CTF agent",
        "command": [
          "/home/t/Dotfiles/harness-dots/pi/bash/pi-ctf"
        ],
        "env": {
          "PI_CODING_AGENT_DIR": "/home/t/Dotfiles/harness-dots/pi/agent_ctf"
        }
      },
      "pi-producer": {
        "extends": "pi",
        "label": "Pi video producer agent",
        "command": [
          "/home/t/Dotfiles/harness-dots/pi/bash/pi-producer"
        ],
        "env": {
          "PI_CODING_AGENT_DIR": "/home/t/Dotfiles/harness-dots/pi/agent_producer"
        }
      },
      "pi": {
        "command": [
          "/home/t/Dotfiles/harness-dots/pi/bash/vpi"
        ],
        "env": {
          "PI_CODING_AGENT_DIR": "/home/t/Dotfiles/harness-dots/pi/agent"
        }
      },
      "claude-coi": {
        "extends": "claude",
        "label": "Claude (coi)",
        "description": "Claude Code wrapped with coi using the coi-default container image",
        "command": [
          "$PASEO_HOME/bin/claude-coi"
        ],
        "env": {
          "CLAUDE_CONFIG_DIR": "$COI_HOME/state/claude"
        },
        "paseoTools": {
          "enabled": false
        }
      },
      "agy-coi": {
        "extends": "acp",
        "label": "Antigravity (coi)",
        "description": "Antigravity CLI (ACP) wrapped with coi using the coi-agy container image",
        "command": [
          "$PASEO_HOME/bin/agy-coi"
        ],
        "options": {
          "clientCapabilities": {
            "fs": {
              "readTextFile": false,
              "writeTextFile": false
            },
            "terminal": false
          }
        },
        "paseoTools": {
          "enabled": false
        }
      }
    }
  },
  "features": {
    "dictation": {
      "enabled": true
    },
    "voiceMode": {
      "enabled": true
    }
  }
}
