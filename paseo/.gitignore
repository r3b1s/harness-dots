# paseo/ holds only authored config. Paseo's runtime state, logs, keys and the
# live config.json (with UI changes and the daemon password) stay in
# $PASEO_HOME (~/.paseo); install.sh copies tracked files there, never links them.

# install.sh backups/temps, should one ever run with --home pointed here
*.bak
.config.json.*
.paseo-*

# agy-coi host-side ACP adapter caches (per coi profile: version.txt, acp-init-result.json, probe-workspace)
coi-*/
