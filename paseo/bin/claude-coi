#!/usr/bin/env bash
set -euo pipefail

# Paseo's version probe (`--version`) and model-discovery probe
# (`--no-session-persistence --tools ""`) use short timeouts (<=5s) and
# `SIGKILL` after 200ms, which can interrupt `coi run` during container
# boot/teardown and orphan ephemeral containers. Handle those read-only
# metadata probes directly on the host; all real sessions and `auth status`
# run inside `coi`.
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  exec claude --version
fi

has_no_persist=0
has_empty_tools=0
prev=""
for arg in "$@"; do
  if [ "$arg" = "--no-session-persistence" ]; then
    has_no_persist=1
  fi
  if [ "$prev" = "--tools" ] && [ -z "$arg" ]; then
    has_empty_tools=1
  fi
  prev="$arg"
done
if [ "$has_no_persist" -eq 1 ] && [ "$has_empty_tools" -eq 1 ]; then
  exec claude "$@"
fi

ws="${PWD}"
if [ -z "$ws" ] || [ "$ws" = "/" ] || [ ! -d "$ws" ]; then
  ws="/tmp"
fi

# Environment variables (all optional; defaults match the `claude` coi profile):
#   PASEO_COI_PROFILE      coi profile to run (default: claude)
#   PASEO_COI_MCP_CONFIG   in-container path passed to claude via --mcp-config
#   PASEO_COI_SEED         named browser seed for coi-desktop (default: empty = none)
#   PASEO_COI_DESKTOP_BIN  path to coi-desktop launcher (default: ${COI_HOME:-$HOME/.coi}/bin/coi-desktop)
#
# Forward Paseo/Claude SDK environment variables into the container without
# passing host CLAUDE_CONFIG_DIR (container claude uses /home/code/.claude,
# whose projects/ dir is bind-mounted by the selected coi profile, e.g.
# `claude` or `claude-desktop`, from $COI_HOME/state/claude/projects).
coi_profile="${PASEO_COI_PROFILE:-claude}"
coi_seed="${PASEO_COI_SEED:-}"

coi_cmd=(coi)
if [ -n "$coi_seed" ]; then
  desktop_bin="${PASEO_COI_DESKTOP_BIN:-${COI_HOME:-${HOME:-}/.coi}/bin/coi-desktop}"
  if [ ! -f "$desktop_bin" ] || [ ! -x "$desktop_bin" ]; then
    printf 'coi-desktop launcher is missing or not executable: %s (run coi/install.sh)\n' "$desktop_bin" >&2
    exit 1
  fi
  coi_cmd=("$desktop_bin" run --seed "$coi_seed" --)
fi

env_args=()
for var in \
  CLAUDE_CODE_EMIT_SESSION_STATE_EVENTS \
  CLAUDE_CODE_ENABLE_SDK_FILE_CHECKPOINTING \
  CLAUDE_CODE_ENTRYPOINT \
  CLAUDE_AGENT_SDK_VERSION \
  ANTHROPIC_API_KEY \
  ANTHROPIC_AUTH_TOKEN \
  ANTHROPIC_BASE_URL \
  ANTHROPIC_MODEL \
  ANTHROPIC_SMALL_FAST_MODEL \
  ANTHROPIC_DEFAULT_HAIKU_MODEL \
  ANTHROPIC_DEFAULT_SONNET_MODEL \
  ANTHROPIC_DEFAULT_OPUS_MODEL \
  CLAUDE_CODE_USE_BEDROCK \
  CLAUDE_CODE_USE_VERTEX \
  CLAUDE_CODE_USE_FOUNDRY \
  CLAUDE_CODE_EFFORT_LEVEL \
  CLAUDE_CODE_MAX_OUTPUT_TOKENS \
  DISABLE_TELEMETRY \
  DISABLE_ERROR_REPORTING
do
  if [ "${!var+set}" = "set" ]; then
    env_args+=("${var}=${!var}")
  fi
done

claude_cmd=(claude)
if [ -n "${PASEO_COI_MCP_CONFIG:-}" ]; then
  claude_cmd+=(--mcp-config "$PASEO_COI_MCP_CONFIG")
fi
claude_cmd+=("$@")

if [ "${#env_args[@]}" -gt 0 ]; then
  exec "${coi_cmd[@]}" run --profile "$coi_profile" -w "$ws" -- env "${env_args[@]}" "${claude_cmd[@]}"
else
  exec "${coi_cmd[@]}" run --profile "$coi_profile" -w "$ws" -- "${claude_cmd[@]}"
fi
